{
  "name": "lrweb-console",
  "version": "1.0.0",
  "private": true,
  "description": "LRWeb Console: onboard servers and clients, move traffic safely, talk privately, with CloudPanel and billing integrations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test \"server/test/*.test.mjs\"",
    "mockup": "node tools/build-mockup.mjs",
    "check": "node tools/check-style.mjs",
    "check:all": "node tools/check-style.mjs && node --test \"server/test/*.test.mjs\""
  }
}
